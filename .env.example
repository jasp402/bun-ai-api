# Configuración del servidor
PORT=3000

# Servicios de IA (Comentar o eliminar si no se usan)

# Gemini (Google)
GEMINI_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Grok (xAI)
XAI_API_KEY=

# Kimi (Moonshot AI)
MOONSHOT_API_KEY=

# GLM (Zhipu AI)
ZHIPU_API_KEY=

# Anthropic-GLM (Z.AI Proxy)
ANTHROPIC_GLM_API_KEY=

# Mistral AI
MISTRAL_API_KEY=

# Cerebras
CEREBRAS_API_KEY=

# Groq
GROQ_API_KEY=

#OpenRouter
OPEN_ROUTER_API_KEY=

# Brave Search
BRAVE_SEARCH_API=

# Telegram
TELEGRAM_BOT_API_KEY=

# WhatsApp Web via WPPConnect
WHATSAPP_ENABLED=false
WHATSAPP_SESSION_NAME=bun-ai-api
WHATSAPP_SESSION_DIR=.wppconnect
WHATSAPP_HEADFUL=false
WHATSAPP_DEVICE_NAME=bun-ai-api
WHATSAPP_CHROME_PATH=
WHATSAPP_ALLOWED_IDS=
WHATSAPP_ALLOWED_GROUP_IDS=
WHATSAPP_GROUP_ALLOW_ALL_MEMBERS=true
WHATSAPP_REQUIRED_PREFIX=@jaspbot
WHATSAPP_GROUP_TRIGGERS=
# Telegram Security
# Comma-separated list of allowed user IDs to interact with the bot. Leave empty to allow anyone (not recommended).
ALLOWED_TELEGRAM_USERS=